  "components": {
    "typography": {
      "fontSize": {
        "small": "11px",
        "medium": "15px",
        "large": "18px"
      },
      "fontFamily": "Georgia, 'Times New Roman', serif"
    },
    "button": {
      "padding": {
        "small": "6px 14px",
        "medium": "10px 22px",
        "large": "14px 30px"
      },
      "margin": {
        "base": "0px"
      },
      "fontSize": {
        "small": "11px",
        "medium": "15px",
        "large": "18px"
      }
    }
